#!/usr/bin/env python3
"""
Awe - Material 3 Desktop Widgets Manager & CLI Companion
"""

import sys
import os
import json
import subprocess
import shutil
import time

# Resolve Awe directory
SCRIPT_PATH = os.path.realpath(__file__)
AWE_DIR = os.path.dirname(os.path.dirname(SCRIPT_PATH))
SETTINGS_PATH = os.path.expanduser("~/.config/quickshell/widget_settings.json")
AUTOSTART_DIR = os.path.expanduser("~/.config/autostart")
AUTOSTART_FILE = os.path.join(AUTOSTART_DIR, "awe.desktop")
DESKTOP_ENTRY_DIR = os.path.expanduser("~/.local/share/applications")
DESKTOP_ENTRY_FILE = os.path.join(DESKTOP_ENTRY_DIR, "awe-settings.desktop")
LOCAL_BIN_DIR = os.path.expanduser("~/.local/bin")
LOCAL_BIN_FILE = os.path.join(LOCAL_BIN_DIR, "awe")

# Theme metadata
THEMES = [
    ("system", "System Dynamic", "Material 3 palette extracted from wallpaper via Matugen"),
    ("liquid_glass", "Liquid Glass", "Translucent frosted glass with specular gloss"),
    ("transparent", "Transparent", "Minimal see-through floating aesthetic"),

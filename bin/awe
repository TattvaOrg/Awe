    ("evergreen_moss", "Evergreen", "Translucent forest green with phosphor telemetry"),
    ("aurora_prism", "Aurora Prism", "Crystal glass with iridescent aurora reflections"),
]

WIDGETS = [
    ("clock", "Clock", "Multi-style clock with cookie, nothing, android stacked, and digital"),
    ("poster", "Poster", "Photo frame with organic shapes and animated GIF support"),
    ("calendar", "Calendar", "Interactive monthly calendar with date selection grid"),
    ("media", "Media Player", "MPRIS controller with fluid seekbar and soundwave bars"),
    ("sysinfo", "System Info", "Overview of CPU load, memory utilization, and disk"),
